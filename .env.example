# ---- LLM key pool (required, at least 2) ----
# Comma-separated; ids are key_1, key_2, ... in this order. Free keys: https://console.groq.com/keys
LLM_API_KEYS=gsk_your_first_key,gsk_your_second_key
# LiteLLM model name used by every key
LLM_MODEL=groq/llama-3.1-8b-instant
# Optional per-key models (same order as LLM_API_KEYS), e.g. groq/llama-3.1-8b-instant,gemini/gemini-2.0-flash
LLM_MODELS=

# ---- Storage ----
DATABASE_URL=sqlite:////data/app.db

# ---- CORS: comma-separated frontend origins ----
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ---- Failover test hook (X-Simulate-Failure header) ----
ENABLE_FAILURE_SIMULATION=true

# ---- LiteLLM cache: disk (persists in the /data volume) | local (in-memory) | none ----
CACHE_TYPE=disk
CACHE_DIR=/data/llm_cache
CACHE_TTL_SECONDS=86400

# ---- Optional tuning ----
DEFAULT_SYSTEM_PROMPT=You are a helpful, concise assistant. Answer clearly and accurately. Use earlier messages in this conversation as context.
LLM_TIMEOUT_SECONDS=30
LLM_MAX_OUTPUT_TOKENS=1024
LLM_TEMPERATURE=0.2
MAX_HISTORY_MESSAGES=40

# ---- Frontend (docker compose) ----
FRONTEND_API_BASE_URL=http://localhost:8000
